{
  "name": "@bigbluedoor/moderngov-test",
  "version": "1.0.0",
  "description": "Utility package usefull to test moderngov template implementation.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "moderngov-test": "dist/index.js"
  },
  "files": [
    "dist",
    "config.json.dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "npm run build && node dist/index.js",
    "prepare": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigbluedoor/moderngov-test.git"
  },
  "keywords": [
    "moderngov",
    "localgov",
    "drupal",
    "template"
  ],
  "author": "Marco Pagliarulo",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/bigbluedoor/moderngov-test/issues"
  },
  "homepage": "https://github.com/bigbluedoor/moderngov-test#readme",
  "dependencies": {
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "express": "^5.2.1",
    "impit": "^0.14.5",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
